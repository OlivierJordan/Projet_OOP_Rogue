<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>


<!--Par défaut IntelliJ a généré un <AnchorPane> comme base de la fenêtre.-->

<!--Pour un tableau de bord de jeu complexe (avec une grille au centre, des stats à gauche, un historique en bas), ce n'est pas le bon outil. -->
<!--Si on avait gardé ce code, tu aurais dû glisser un BorderPane à l'intérieur de cet AnchorPane, ce qui crée des "couches" inutiles et de mauvaises pratiques d'optimisation. -->
<!--En remplaçant tout le code, on a forcé le fichier à utiliser directement un <BorderPane> comme fondation principale.-->

<!--Nous avons accompli 4 actions simultanées en une seule ligne :-->
<!--1. Changer le type de la fenêtre (BorderPane).-->
<!--2. Définir la taille par défaut de la fenêtre (prefHeight="720.0" prefWidth="1080.0").-->
<!--3. Lier le bon contrôleur (fx:controller="com.example...").-->
<!--Créer les sous-zones (Left, Center, Bottom).-->
<BorderPane prefHeight="720.0" prefWidth="1080.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.projet_oop_rogue.controllers.MainGameController">

    <left>
        <VBox prefWidth="250.0" spacing="15.0" style="-fx-background-color: #2c3e50;" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>
                <Label text="STATISTIQUES" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                </Label>
                <Label fx:id="playerInfoLabel" text="Joueur : - | Classe : -" textFill="WHITE" wrapText="true" />
                <Label fx:id="hpLabel" text="HP : 0 / 0" textFill="#2ecc71">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Label>
                <Label fx:id="damageLabel" text="Dégâts : 0" textFill="#e74c3c" />
            </children>
        </VBox>
    </left>

    <center>
        <GridPane fx:id="gameBoard" alignment="CENTER" gridLinesVisible="true" BorderPane.alignment="CENTER">
        </GridPane>
    </center>

    <bottom>
        <VBox prefHeight="150.0" BorderPane.alignment="CENTER">
            <children>
                <TextArea fx:id="battleLogs" editable="false" prefHeight="150.0" text="Bienvenue dans le donjon !" wrapText="true">
                    <font>
                        <Font name="Consolas" size="14.0" />
                    </font>
                </TextArea>
            </children>
        </VBox>
    </bottom>

</BorderPane>


